# Hoist all packages to root node_modules so the root-level tsx runner
# (used by test:coverage) can resolve dependencies and workspace packages.
shamefully-hoist=true

# Unrelated to any single feature branch: newer pnpm blocks package postinstall
# scripts by default. esbuild's postinstall needs to run to fetch its native
# binary, so it must be explicitly allow-listed here and in pnpm-workspace.yaml's
# allowBuilds (and package.json's pnpm.onlyBuiltDependencies, which mirrors this
# for npm/corepack-driven installs). Without this, `pnpm install` fails in any
# environment using a pnpm version with this default (e.g. this repo's Oli build
# sandbox). Do not remove without confirming pnpm install still succeeds in that
# environment.
onlyBuiltDependencies[]=esbuild
unsafe-perm=true
