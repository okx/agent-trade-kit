# Hoist all packages to root node_modules so the root-level tsx runner
# (used by test:coverage) can resolve dependencies and workspace packages.
shamefully-hoist=true

# Note: esbuild's postinstall (needed to fetch its native binary) is
# allow-listed via pnpm-workspace.yaml's `allowBuilds.esbuild: true`, not
# here. An onlyBuiltDependencies[]=esbuild line used to live in this file but
# was confirmed (empirically, under this repo's pnpm 12.5.1) to have no
# effect on its own -- removed to avoid implying it does something.
unsafe-perm=true
